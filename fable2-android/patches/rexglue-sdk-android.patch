 namespace rex::thread {
 
 thread_local Fiber* Fiber::tls_current_ = nullptr;
 
+#if REX_PLATFORM_ANDROID
+
+// bionic has no getcontext/makecontext/swapcontext. Switch fibers the way
+// Boost.Context's fcontext does: push the AAPCS64 callee-saved registers
+// (x19-x30, d8-d15) on the current stack, store sp, load the target's sp and
+// pop its registers. The final `ret` resumes the target where it last called
+// rex_fiber_switch (or, for a new fiber, at Fiber::Trampoline).
+extern "C" void rex_fiber_switch(void** save_sp, void* load_sp);
+asm(R"(
+    .text
+    .p2align 2
+    .globl  rex_fiber_switch
+    .hidden rex_fiber_switch
+    .type   rex_fiber_switch, %function
+rex_fiber_switch:
+    sub  sp, sp, #160
+    stp  x19, x20, [sp, #0]
+    stp  x21, x22, [sp, #16]
+    stp  x23, x24, [sp, #32]
+    stp  x25, x26, [sp, #48]
+    stp  x27, x28, [sp, #64]
+    stp  x29, x30, [sp, #80]
+    stp  d8,  d9,  [sp, #96]
+    stp  d10, d11, [sp, #112]
+    stp  d12, d13, [sp, #128]
+    stp  d14, d15, [sp, #144]
+    mov  x2, sp
+    str  x2, [x0]
+    mov  sp, x1
+    ldp  x19, x20, [sp, #0]
+    ldp  x21, x22, [sp, #16]
+    ldp  x23, x24, [sp, #32]
+    ldp  x25, x26, [sp, #48]
+    ldp  x27, x28, [sp, #64]
+    ldp  x29, x30, [sp, #80]
+    ldp  d8,  d9,  [sp, #96]
+    ldp  d10, d11, [sp, #112]
+    ldp  d12, d13, [sp, #128]
+    ldp  d14, d15, [sp, #144]
+    add  sp, sp, #160
+    ret
+    .size rex_fiber_switch, .-rex_fiber_switch
+)");
+
+namespace {
+constexpr size_t kSwitchFrameSize = 160;  // must match rex_fiber_switch
+constexpr size_t kSwitchFrameLrSlot = 11;  // x30 at [sp, #88]
+}  // namespace
+
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* f = new Fiber();
+  f->is_thread_fiber_ = true;  // sp_ is filled in by the first SwitchTo away
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_.resize(stack_size);
+
+  // Initial frame at the 16-byte-aligned top of the stack: all saved
+  // registers zero (x29 = 0 ends frame-pointer unwinding), x30 = Trampoline,
+  // so the first switch "returns" into Trampoline with an aligned sp.
+  auto top = (reinterpret_cast<uintptr_t>(f->stack_.data()) + f->stack_.size()) & ~uintptr_t(15);
+  auto* frame = reinterpret_cast<uint64_t*>(top - kSwitchFrameSize);
+  std::memset(frame, 0, kSwitchFrameSize);
+  frame[kSwitchFrameLrSlot] = reinterpret_cast<uint64_t>(&Fiber::Trampoline);
+  f->sp_ = frame;
+  return f;
+}
+
+/*static*/ void Fiber::Trampoline() {
+  // tls_current_ was updated by SwitchTo before the stack switch.
+  Fiber* f = tls_current_;
+  f->entry_(f->arg_);
+  // A fiber entry must switch away instead of returning: there is no caller
+  // frame to return to (ucontext's uc_link = nullptr ends the thread).
+  std::abort();
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  tls_current_ = target;
+  rex_fiber_switch(&from->sp_, target->sp_);
+}
+
+#else  // !REX_PLATFORM_ANDROID
