+#pragma once
+/**
+ * @file        main_android.h
+ * @brief       Android process-level helpers (API level query, startup init).
+ *
+ * @license     BSD 3-Clause License
+ */
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_ANDROID
+
+#include <android/api-level.h>
+
+namespace rex {
+
+// Device API level (not the NDK minSdk the library was built against).
+inline int GetAndroidApiLevel() {
+  static const int api_level = android_get_device_api_level();
+  return api_level;
+}
+
+// Initializes the dynamically loaded Android functions used by the memory and
+// threading layers. Call once, before the runtime is created.
+void InitializeAndroidProcess();
+void ShutdownAndroidProcess();
+
+}  // namespace rex
+
+#endif  // REX_PLATFORM_ANDROID
