+/**
+ * @file        core/main_android.cpp
+ * @brief       Android process-level initialization.
+ *
+ * @license     BSD 3-Clause License
+ */
+
+#include <rex/main_android.h>
+
+#include <cerrno>
+
+#include <rex/filesystem.h>
+#include <rex/memory/utils.h>
+#include <rex/thread.h>
+
+namespace rex {
+
+void InitializeAndroidProcess() {
+  rex::memory::AndroidInitialize();
+  rex::thread::AndroidInitialize();
+}
+
+void ShutdownAndroidProcess() {
+  rex::thread::AndroidShutdown();
+  rex::memory::AndroidShutdown();
+}
+
+}  // namespace rex
+
+namespace rex::filesystem {
+
+// Declared for Xenia's Storage Access Framework (content://) support, which
+// needs a JNI bridge to ContentResolver. This port reads game files through
+// plain paths in the app's files directory, so content URIs are reported as
+// unsupported instead.
+bool IsAndroidContentUri(const std::string_view source) {
+  return source.starts_with("content://");
+}
+
+int OpenAndroidContentFileDescriptor(const std::string_view uri, const char* mode) {
+  (void)uri;
+  (void)mode;
+  errno = ENOTSUP;
+  return -1;
+}
+
+}  // namespace rex::filesystem
