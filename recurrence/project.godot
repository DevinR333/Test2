; Engine configuration file.
; Open this folder with Godot 4.4+ (Project Manager > Import).

config_version=5

[application]

config/name="Recurrence"
config/description="An original looping-hallway horror game for Android."
run/main_scene="res://scenes/creature_viewer.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[display]

window/size/viewport_width=1440
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=128
